# Entorno: development | test | production
NODE_ENV=development
PORT=3000

# Orígenes permitidos por CORS (separados por coma): Vite dev (5174) y frontend en Docker
CORS_ORIGIN=http://localhost:5174,http://localhost:8080

# PostgreSQL (el compose.yml expone el contenedor en el puerto 5433 del equipo)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dre_loreto

# JWT (mínimo 32 caracteres). Cambiar fuera del entorno local.
JWT_SECRET=cambia-este-secreto-local-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h

# Usuario administrador inicial que crea el seed
SEED_ADMIN_EMAIL=admin@drel.local
SEED_ADMIN_PASSWORD=Admin2026!Local

# Solo desarrollo local: crea usuarios de prueba (secretaria, director, especialista)
SEED_DEMO_USERS=true
SEED_DEMO_PASSWORD=Demo2026!Local
